PORT=3000
# Orígenes permitidos para CORS, separados por coma (frontend local y el de Vercel)
FRONTEND_ORIGINS=http://localhost:5173,https://tu-frontend.vercel.app
# Cadena de conexión de MongoDB Atlas (NUNCA subir la real al repositorio)
MONGODB_URI=mongodb+srv://<DB_USER>:<DB_PASSWORD>@<CLUSTER_URL>/<DATABASE_NAME>
# Llave para firmar los tokens de sesión (cadena larga y aleatoria)
JWT_SECRET=<CAMBIAR_POR_UNA_CADENA_SECRETA_LARGA>
JWT_EXPIRES_IN=8h
